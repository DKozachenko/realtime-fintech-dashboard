{
  "name": "realtime-fintech-dashboard",
  "version": "0.0.0",
  "author": {
    "name": "Diana Kozachenko",
    "email": "public@dkozachenko.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "npm run build:wasm && ng serve",
    "build": "npm run build:wasm && npm run build:app",
    "build:app": "ng build",
    "build:wasm": "wasm-pack build generator --target web --release --out-dir ../src/wasm/generator --out-name generator",
    "test:wasm": "cargo test --manifest-path generator/Cargo.toml",
    "test": "npm run build:wasm && npm run test:app",
    "test:app": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "lint": "eslint --config configs/eslint/eslint.config.ts \"src/**/*.{ts,html}\"",
    "stylelint": "stylelint --config configs/stylelint/stylelint.config.js \"src/**/*.scss\"",
    "lint:rust": "cargo fmt --manifest-path generator/Cargo.toml -- --check --config-path configs/rust/rustfmt.toml && cargo clippy --manifest-path generator/Cargo.toml --all-targets -- -D warnings"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@angular/router": "19.2.25",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.27",
    "@angular/cli": "19.2.27",
    "@angular/compiler-cli": "19.2.25",
    "@types/jasmine": "5.1.15",
    "angular-eslint": "19.8.1",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "jasmine-core": "5.6.0",
    "jiti": "2.7.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-prettier": "5.0.3",
    "stylelint-scss": "7.3.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.0"
  }
}
